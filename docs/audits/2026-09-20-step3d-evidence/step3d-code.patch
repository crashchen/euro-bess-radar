+    prices = pd.DataFrame(
+        {"price_eur_mwh": [50.0] * 23},
+        index=pd.date_range("2026-03-28 23:00", periods=23, freq="h", tz="UTC"),
+    )
+    context = (
+        {"primary_zone": zone}
+        if "primary_zone" in inspect.signature(
+            cockpit._compute_forecast_policy_bundle
+        ).parameters else {}
