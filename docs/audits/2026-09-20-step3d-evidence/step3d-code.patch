+    sequential, _ = simulate_sequential_da_id_reserve_batch(
+        da, ida, reserve, dates=[target], tz="Europe/Berlin", bucket="hour_of_day", **common,
+    )
+    ceiling = simulate_da_id_reserve_ceiling_batch(
