+@pytest.mark.slow
+@pytest.mark.parametrize(
+    "target, physical_hours, screening_cash",
+    [(date(2025, 3, 29), 24, 456.0), (date(2025, 3, 30), 23, 437.0),
+     (date(2025, 10, 26), 25, 475.0)],
